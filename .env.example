# DayZero runs completely without any of these. The decision brief falls back
# to a deterministic template, so the app never shows an LLM error.

# ---------------------------------------------------------------------------
# Recommended: Ollama (free)
# ---------------------------------------------------------------------------
# If Ollama is running locally, DayZero finds it automatically -- no config at
# all. Sign in once with `ollama signin` (free account) and it can also reach
# Ollama's *cloud* models, which answer in ~4s instead of minutes on CPU.
#
# To use those cloud models from a DEPLOYED server, which has no local Ollama,
# create a key at https://ollama.com/settings/keys and set:
# OLLAMA_API_KEY=...
#
# Point at a non-default Ollama (remote box, different port):
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Alternatives
# ---------------------------------------------------------------------------
# Which backend writes the brief: ollama | groq | openrouter | anthropic | none
# Leave unset for "auto": a hosted key if present, else Ollama if reachable,
# else the template.
# DAYZERO_LLM=ollama

# Force one specific model instead of auto-selecting the best available.
# DAYZERO_LLM_MODEL=gemma4:31b-cloud

# Other free tiers, no credit card:
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Paid, only if hackathon credits appear:
# ANTHROPIC_API_KEY=sk-ant-...
